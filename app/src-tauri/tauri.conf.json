{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Digerati",
  "version": "1.0.0",
  "identifier": "in.digerati.app",
  "build": {
    "frontendDist": "../frontend",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Digerati",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Games",
    "shortDescription": "Champak Jogo Disk - the Digerati archive app",
    "longDescription": "Download, explore and play the complete Champak Jogo Disk cover CD archive: Flash games, Shockwave titles, tools, wallpapers, colouring sheets and more.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}